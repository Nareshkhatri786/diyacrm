<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Category for Property & Unit Inventory in User Management -->
    <record id="module_category_property_inventory" model="ir.module.category">
        <field name="name">Diya CRM Property</field>
        <field name="description">Access rights for Property Unit Inventory and Visual Matrix</field>
        <field name="sequence">15</field>
    </record>

    <!-- 2. Developer Access Group (Unit Inventory Only) -->
    <record id="group_property_developer" model="res.groups">
        <field name="name">Developer (Unit Inventory Only)</field>
        <field name="category_id" ref="module_category_property_inventory"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Access level for property developers/builders. Grants access ONLY to Unit Inventory and Visual Unit Matrix. No access to CRM leads, call logs, WhatsApp, attendance, or settings.</field>
    </record>

    <!-- 3. Multi-Company Record Rule: Each company only sees its own units -->
    <record id="crm_property_unit_rule_company" model="ir.rule">
        <field name="name">Property Unit Multi-Company Isolation</field>
        <field name="model_id" ref="model_crm_property_unit"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
