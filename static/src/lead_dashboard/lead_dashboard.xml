<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="diyacrm.CrmLeadAnalyticsDashboard">
        <div class="o_lead_analytics_dashboard bg-light h-100 overflow-auto p-3 p-md-4">

            <!-- ── HEADER BAR ──────────────────────────────────────────── -->
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 bg-white p-3 rounded-3 shadow-sm border">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold"
                         style="width:46px;height:46px;font-size:20px;">📊</div>
                    <div>
                        <h4 class="mb-0 fw-bold text-dark">Lead Analytics Dashboard</h4>
                        <div class="text-muted small">Total lead funnel, cost, source &amp; trend analysis</div>
                    </div>
                </div>
                <button class="btn btn-outline-secondary btn-sm mt-2 mt-md-0" t-on-click="() => this.loadData()">
                    <i class="fa fa-refresh me-1"/> Refresh
                </button>
            </div>

            <!-- ── FILTERS ─────────────────────────────────────────────── -->
            <div class="bg-white rounded-3 shadow-sm border p-3 mb-3">
                <div class="d-flex flex-wrap align-items-center gap-2">

                    <!-- Date Presets -->
                    <div class="btn-group btn-group-sm" role="group">
                        <button t-foreach="[['all','All Time'],['today','Today'],['week','This Week'],['month','This Month'],['quarter','This Quarter'],['year','This Year']]"
                                t-as="preset" t-key="preset[0]"
                                t-attf-class="btn #{state.datePreset === preset[0] ? 'btn-primary' : 'btn-outline-secondary'}"
                                t-on-click="() => this.setPreset(preset[0])">
                            <t t-esc="preset[1]"/>
                        </button>
                    </div>

                    <span class="text-muted small fw-bold">Custom:</span>
                    <input type="date" class="form-control form-control-sm" style="width:150px;"
                           t-att-value="state.dateFrom"
                           t-on-change="(ev) => this.onDateFromChange(ev)"/>
                    <span class="text-muted">→</span>
                    <input type="date" class="form-control form-control-sm" style="width:150px;"
                           t-att-value="state.dateTo"
                           t-on-change="(ev) => this.onDateToChange(ev)"/>

                    <span class="text-muted small fw-bold ms-2">Project:</span>
                    <select class="form-select form-select-sm" style="width:200px;"
                            t-on-change="(ev) => this.onCompanyChange(ev)">
                        <option value="all">🏢 All Projects</option>
                        <t t-foreach="state.companies" t-as="comp" t-key="comp.id">
                            <option t-att-value="comp.id" t-att-selected="state.companyFilter == comp.id">
                                <t t-esc="comp.name"/>
                            </option>
                        </t>
                    </select>
                </div>
            </div>

            <!-- ── LOADING ─────────────────────────────────────────────── -->
            <div t-if="state.loading" class="text-center py-5">
                <i class="fa fa-circle-o-notch fa-spin fa-3x text-primary mb-3"/>
                <div class="text-muted fs-5">Loading analytics...</div>
            </div>

            <div t-if="!state.loading">

                <!-- ── KPI CARDS ────────────────────────────────────────── -->
                <div class="row g-3 mb-4">
                    <!-- Total Leads -->
                    <div class="col-6 col-md-4 col-lg-2">
                        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-primary h-100 cursor-pointer"
                             t-on-click="() => this.onKpiClick('total')">
                            <div class="text-muted small fw-semibold text-uppercase">📥 Total Leads</div>
                            <div class="fs-2 fw-bold text-primary mt-1"><t t-esc="state.kpi.total.toLocaleString('en-IN')"/></div>
                            <div class="small text-muted">All time enquiries</div>
                        </div>
                    </div>
                    <!-- Active -->
                    <div class="col-6 col-md-4 col-lg-2">
                        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-success h-100 cursor-pointer"
                             t-on-click="() => this.onKpiClick('active')">
                            <div class="text-muted small fw-semibold text-uppercase">✅ Active</div>
                            <div class="fs-2 fw-bold text-success mt-1"><t t-esc="state.kpi.active.toLocaleString('en-IN')"/></div>
                            <div class="small text-muted">In pipeline</div>
                        </div>
                    </div>
                    <!-- Lost -->
                    <div class="col-6 col-md-4 col-lg-2">
                        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-danger h-100 cursor-pointer"
                             t-on-click="() => this.onKpiClick('lost')">
                            <div class="text-muted small fw-semibold text-uppercase">❌ Lost</div>
                            <div class="fs-2 fw-bold text-danger mt-1"><t t-esc="state.kpi.lost.toLocaleString('en-IN')"/></div>
                            <div class="small text-muted">Closed / archived</div>
                        </div>
                    </div>
                    <!-- Won/Booked -->
                    <div class="col-6 col-md-4 col-lg-2">
                        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-warning h-100 cursor-pointer"
                             t-on-click="() => this.onKpiClick('won')">
                            <div class="text-muted small fw-semibold text-uppercase">🏆 Won/Booked</div>
                            <div class="fs-2 fw-bold mt-1" style="color: #b45309 !important;"><t t-esc="state.kpi.won.toLocaleString('en-IN')"/></div>
                            <div class="small text-muted"><t t-esc="state.kpi.conversion_pct"/>% conversion</div>
                        </div>
                    </div>
                    <!-- Repeat -->
                    <div class="col-6 col-md-4 col-lg-2">
                        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-info h-100 cursor-pointer"
                             t-on-click="() => this.onKpiClick('repeat')">
                            <div class="text-muted small fw-semibold text-uppercase">🔄 Repeat</div>
                            <div class="fs-2 fw-bold text-info mt-1"><t t-esc="state.kpi.repeat.toLocaleString('en-IN')"/></div>
                            <div class="small text-muted"><t t-esc="state.kpi.repeat_leads || 0"/> unique clients</div>
                        </div>
                    </div>
                    <!-- Cost -->
                    <div class="col-6 col-md-4 col-lg-2">
                        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-success h-100">
                            <div class="text-muted small fw-semibold text-uppercase">💰 Total Cost</div>
                            <div class="fs-2 fw-bold mt-1" style="color: #0f172a !important; font-weight: 800;">
                                <t t-esc="this.fmt_inr(state.kpi.total_cost)"/>
                            </div>
                            <div class="small text-muted mt-1" style="font-size: 0.76rem;">
                                Fresh: <strong class="text-dark"><t t-esc="this.fmt_inr(state.kpi.fresh_cost || 0)"/></strong> · Rep: <strong class="text-dark"><t t-esc="this.fmt_inr(state.kpi.repeat_cost || 0)"/></strong>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ── ROW 2: Project breakdown + Stage Funnel ─────────── -->
                <div class="row g-3 mb-4">

                    <!-- Project / Company Breakdown -->
                    <div class="col-12 col-lg-7">
                        <div class="card border-0 shadow-sm rounded-3 h-100">
                            <div class="card-header bg-white fw-bold border-bottom py-3">
                                🏭 Project-wise Breakdown
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover table-sm mb-0 small">
                                        <thead class="table-light sticky-top">
                                            <tr>
                                                <th>Project</th>
                                                <th class="text-center">Total</th>
                                                <th class="text-center text-success">Active</th>
                                                <th class="text-center text-danger">Lost</th>
                                                <th class="text-center fw-bold" style="color: #b45309 !important;">Won</th>
                                                <th class="text-center text-info">Repeat Hits</th>
                                                <th class="text-end">₹/Lead</th>
                                                <th class="text-end">Total Cost</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="state.company_data" t-as="c" t-key="c.id">
                                                <tr>
                                                    <td class="fw-semibold text-truncate" style="max-width:140px;" t-att-title="c.company"><t t-esc="c.company"/></td>
                                                    <td class="text-center fw-bold"><t t-esc="c.total"/></td>
                                                    <td class="text-center text-success"><t t-esc="c.active"/></td>
                                                    <td class="text-center text-danger"><t t-esc="c.lost"/></td>
                                                    <td class="text-center fw-bold" style="color: #b45309 !important;"><t t-esc="c.won"/></td>
                                                    <td class="text-center text-info fw-semibold"><t t-esc="c.repeat"/></td>
                                                    <td class="text-end text-muted">₹<t t-esc="c.cost_per_lead"/></td>
                                                    <td class="text-end fw-bold text-dark" style="color: #0f172a !important; font-size: 0.95rem;"><t t-esc="this.fmt_inr(c.cost)"/></td>
                                                </tr>
                                            </t>
                                            <tr t-if="state.company_data.length === 0">
                                                <td colspan="8" class="text-center text-muted py-3">No data for selected filters</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Stage Funnel -->
                    <div class="col-12 col-lg-5">
                        <div class="card border-0 shadow-sm rounded-3 h-100">
                            <div class="card-header bg-white fw-bold border-bottom py-3">
                                🎯 Stage Funnel
                            </div>
                            <div class="card-body py-2">
                                <t t-set="max_count" t-value="Math.max(...state.stage_funnel.map(s => s.count), 1)"/>
                                <t t-foreach="state.stage_funnel" t-as="stage" t-key="stage.stage">
                                    <div class="mb-2">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="small fw-semibold text-truncate" style="max-width:70%;"><t t-esc="stage.stage"/></span>
                                            <span class="badge bg-primary ms-2"><t t-esc="stage.count"/></span>
                                        </div>
                                        <div class="progress" style="height:8px;">
                                            <div class="progress-bar bg-primary"
                                                 t-attf-style="width: #{Math.round(stage.count / max_count * 100)}%"/>
                                        </div>
                                    </div>
                                </t>
                                <div t-if="state.stage_funnel.length === 0" class="text-center text-muted py-3">No data</div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- ── ROW 3: Source Table + Source Chart ──────────────── -->
                <div class="row g-3 mb-4">
                    <!-- Source Table -->
                    <div class="col-12 col-lg-7">
                        <div class="card border-0 shadow-sm rounded-3 h-100">
                            <div class="card-header bg-white fw-bold border-bottom py-3">
                                📡 Source-wise Breakdown
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover table-sm mb-0 small">
                                        <thead class="table-light sticky-top">
                                            <tr>
                                                <th>Source</th>
                                                <th class="text-center">Total</th>
                                                <th class="text-center text-success">Active</th>
                                                <th class="text-center text-danger">Lost</th>
                                                <th class="text-center fw-bold" style="color: #b45309 !important;">Won</th>
                                                <th class="text-center text-info">Repeat Hits</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="state.source_data" t-as="src" t-key="src.source">
                                                <tr>
                                                    <td class="fw-semibold text-truncate" style="max-width:150px;"><t t-esc="src.source"/></td>
                                                    <td class="text-center fw-bold"><t t-esc="src.total"/></td>
                                                    <td class="text-center text-success"><t t-esc="src.active"/></td>
                                                    <td class="text-center text-danger"><t t-esc="src.lost"/></td>
                                                    <td class="text-center fw-bold" style="color: #b45309 !important;"><t t-esc="src.won"/></td>
                                                    <td class="text-center text-info fw-semibold"><t t-esc="src.repeat"/></td>
                                                </tr>
                                            </t>
                                            <tr t-if="state.source_data.length === 0">
                                                <td colspan="6" class="text-center text-muted py-3">No data</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Source Doughnut -->
                    <div class="col-12 col-lg-5">
                        <div class="card border-0 shadow-sm rounded-3 h-100">
                            <div class="card-header bg-white fw-bold border-bottom py-3">
                                🍩 Source Distribution
                            </div>
                            <div class="card-body d-flex align-items-center justify-content-center" style="height:300px;">
                                <canvas t-ref="sourceChart" style="max-height:280px;"/>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ── ROW 4: Charts ───────────────────────────────────── -->
                <div class="row g-3">
                    <!-- Daily Trend -->
                    <div class="col-12 col-lg-6">
                        <div class="card border-0 shadow-sm rounded-3">
                            <div class="card-header bg-white fw-bold border-bottom py-3">
                                📅 Daily Lead Trend
                            </div>
                            <div class="card-body" style="height:280px;">
                                <canvas t-ref="dailyChart"/>
                            </div>
                        </div>
                    </div>

                    <!-- Monthly Trend -->
                    <div class="col-12 col-lg-6">
                        <div class="card border-0 shadow-sm rounded-3">
                            <div class="card-header bg-white fw-bold border-bottom py-3">
                                📆 Monthly Lead Trend
                            </div>
                            <div class="card-body" style="height:280px;">
                                <canvas t-ref="monthlyChart"/>
                            </div>
                        </div>
                    </div>
                </div>

            </div><!-- /!state.loading -->
        </div>
    </t>
</templates>
