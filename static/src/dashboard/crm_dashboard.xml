<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="diyacrm.CrmExecutiveDashboard">
        <div class="o_crm_dashboard_wrapper">
            <div class="o_crm_dashboard_container">

                <!-- 1. Top Header Bar with Global Filters -->
                <div class="diyacrm-header-card">
                    <div class="diyacrm-header-title">
                        <h2>
                            <i class="fa fa-chart-line text-primary"/>
                            <span>Diya CRM - Real Estate Executive Dashboard</span>
                        </h2>
                        <p>
                            <t t-if="state.isMultiCompany">
                                <span class="badge bg-primary-subtle text-primary fw-bold me-2">Consolidated Multi-Project View</span>
                                <span>Showing live metrics across <strong t-esc="state.activeCompanies.length"/> projects</span>
                            </t>
                            <t t-else="">
                                <span class="badge bg-success-subtle text-success fw-bold me-2">Single Project View</span>
                                <span>Project: <strong><t t-esc="state.activeCompanies[0] ? state.activeCompanies[0].name : 'Default'"/></strong></span>
                            </t>
                        </p>
                    </div>

                    <!-- Dynamic Controls -->
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="diyacrm-live-badge"><i class="fa fa-circle text-white"/> Live Pipeline</span>

                        <!-- Project Selector -->
                        <select class="form-select form-select-sm fw-bold border-secondary-subtle" style="width: auto;" t-on-change="onCompanyChange">
                            <option value="all">🏢 All Allowed Projects</option>
                            <t t-foreach="state.availableCompanies" t-as="comp" t-key="comp.id">
                                <option t-att-value="comp.id" t-esc="comp.name"/>
                            </t>
                        </select>

                        <!-- Date Range Selector -->
                        <select class="form-select form-select-sm fw-bold border-secondary-subtle" style="width: auto;" t-on-change="onPeriodChange">
                            <option value="today">📅 Today</option>
                            <option value="yesterday">📅 Yesterday</option>
                            <option value="48h" selected="selected">📅 Last 48 Hours</option>
                            <option value="week">📅 This Week</option>
                            <option value="month">📅 This Month</option>
                            <option value="all">📅 All Time</option>
                        </select>

                        <button class="btn btn-sm btn-primary d-flex align-items-center gap-1 shadow-sm" t-on-click="loadDashboardData">
                            <i class="fa fa-sync-alt" t-att-class="{'fa-spin': state.loading}"/>
                            <span>Refresh</span>
                        </button>
                    </div>
                </div>

                <!-- 2. Hero KPI Cards Grid -->
                <div class="diyacrm-kpi-grid">
                    <!-- Total Calls -->
                    <div class="diyacrm-kpi-card kpi-border-calls">
                        <div class="diyacrm-kpi-header">
                            <span class="diyacrm-kpi-title">Total Calls</span>
                            <div class="diyacrm-kpi-icon bg-primary-subtle text-primary"><i class="fa fa-phone"/></div>
                        </div>
                        <div class="diyacrm-kpi-value"><t t-esc="state.kpis.total_calls"/></div>
                        <div class="diyacrm-kpi-sub">
                            <span class="badge bg-success-subtle text-success fw-bold">64% Connected</span>
                            <span>In selected range</span>
                        </div>
                    </div>

                    <!-- New Opps -->
                    <div class="diyacrm-kpi-card kpi-border-new cursor-pointer" t-on-click="() => this.openOpportunities('new')">
                        <div class="diyacrm-kpi-header">
                            <span class="diyacrm-kpi-title">New Opps</span>
                            <div class="diyacrm-kpi-icon bg-success-subtle text-success"><i class="fa fa-user-plus"/></div>
                        </div>
                        <div class="diyacrm-kpi-value"><t t-esc="state.kpis.new_opps"/></div>
                        <div class="diyacrm-kpi-sub">
                            <span class="badge bg-success-subtle text-success fw-bold">Fresh WhatsApp / Webhook</span>
                        </div>
                    </div>

                    <!-- Updated Leads -->
                    <div class="diyacrm-kpi-card kpi-border-update">
                        <div class="diyacrm-kpi-header">
                            <span class="diyacrm-kpi-title">Updated Leads</span>
                            <div class="diyacrm-kpi-icon bg-info-subtle text-info"><i class="fa fa-arrows-rotate"/></div>
                        </div>
                        <div class="diyacrm-kpi-value"><t t-esc="state.kpis.updated_opps"/></div>
                        <div class="diyacrm-kpi-sub">
                            <span class="badge bg-info-subtle text-info fw-bold">Repeat Inquiries</span>
                        </div>
                    </div>

                    <!-- Visits Scheduled -->
                    <div class="diyacrm-kpi-card kpi-border-visit">
                        <div class="diyacrm-kpi-header">
                            <span class="diyacrm-kpi-title">Visits Scheduled</span>
                            <div class="diyacrm-kpi-icon bg-warning-subtle text-warning"><i class="fa fa-calendar-check"/></div>
                        </div>
                        <div class="diyacrm-kpi-value"><t t-esc="state.kpis.visits_scheduled"/></div>
                        <div class="diyacrm-kpi-sub">
                            <span class="badge bg-warning-subtle text-warning fw-bold">Upcoming</span>
                        </div>
                    </div>

                    <!-- Visits Done -->
                    <div class="diyacrm-kpi-card kpi-border-visitdone">
                        <div class="diyacrm-kpi-header">
                            <span class="diyacrm-kpi-title">Visits Done</span>
                            <div class="diyacrm-kpi-icon bg-purple-subtle text-purple"><i class="fa fa-car"/></div>
                        </div>
                        <div class="diyacrm-kpi-value"><t t-esc="state.kpis.visits_done"/></div>
                        <div class="diyacrm-kpi-sub">
                            <span class="badge bg-primary-subtle text-primary fw-bold">Completed</span>
                        </div>
                    </div>

                    <!-- Won Deals -->
                    <div class="diyacrm-kpi-card kpi-border-won cursor-pointer" t-on-click="() => this.openOpportunities('won')">
                        <div class="diyacrm-kpi-header">
                            <span class="diyacrm-kpi-title">Won / Booked</span>
                            <div class="diyacrm-kpi-icon bg-success-subtle text-success"><i class="fa fa-trophy"/></div>
                        </div>
                        <div class="diyacrm-kpi-value text-success"><t t-esc="state.kpis.won"/></div>
                        <div class="diyacrm-kpi-sub">
                            <span class="badge bg-success text-white fw-bold">Token Received</span>
                        </div>
                    </div>
                </div>

                <!-- 3. Row 1: Calling Outcomes & 7-Stage Pipeline Funnel -->
                <div class="row g-4 mb-4">
                    <!-- Calling Outcomes -->
                    <div class="col-12 col-lg-6">
                        <div class="diyacrm-card">
                            <div class="diyacrm-card-header">
                                <h4><i class="fa fa-headset text-primary"/> Calling Outcome Analytics</h4>
                                <span class="badge bg-light text-dark fw-bold"><t t-esc="state.kpis.total_calls"/> Dials</span>
                            </div>
                            <div style="height: 150px; position: relative;">
                                <canvas t-ref="callCanvas"/>
                            </div>
                            <div class="diyacrm-outcome-grid">
                                <div class="diyacrm-outcome-box outcome-box-answered">
                                    <div class="outcome-val"><t t-esc="state.calling_outcomes.answered"/></div>
                                    <div class="outcome-name">Answered</div>
                                </div>
                                <div class="diyacrm-outcome-box outcome-box-noanswer">
                                    <div class="outcome-val"><t t-esc="state.calling_outcomes.no_answer"/></div>
                                    <div class="outcome-name">No Answer</div>
                                </div>
                                <div class="diyacrm-outcome-box outcome-box-busy">
                                    <div class="outcome-val"><t t-esc="state.calling_outcomes.busy"/></div>
                                    <div class="outcome-name">Busy</div>
                                </div>
                                <div class="diyacrm-outcome-box outcome-box-switched">
                                    <div class="outcome-val"><t t-esc="state.calling_outcomes.switched_off"/></div>
                                    <div class="outcome-name">Switched Off</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 7-Stage Pipeline Funnel -->
                    <div class="col-12 col-lg-6">
                        <div class="diyacrm-card">
                            <div class="diyacrm-card-header">
                                <h4><i class="fa fa-filter text-primary"/> 7-Stage Active Pipeline Funnel</h4>
                                <span class="badge bg-light text-dark fw-bold">Active Opportunities</span>
                            </div>
                            <div class="d-flex flex-column gap-2 mt-2">
                                <t t-foreach="state.stages" t-as="stg" t-key="stg.id">
                                    <div class="diyacrm-stage-row">
                                        <span class="diyacrm-stage-name" t-esc="stg.name"/>
                                        <div class="diyacrm-stage-bar-wrap">
                                            <div class="diyacrm-stage-bar" t-attf-style="width: #{stg.count ? Math.min(100, stg.count * 3) : 0}%;"/>
                                        </div>
                                        <span class="diyacrm-stage-val" t-esc="stg.count"/>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 4. Row 2: Inbound Channels, Temperature, & Sales Leaderboard -->
                <div class="row g-4 mb-4">
                    <!-- UTM Sources -->
                    <div class="col-12 col-lg-4">
                        <div class="diyacrm-card">
                            <div class="diyacrm-card-header">
                                <h4><i class="fa fa-bullhorn text-primary"/> Inbound Channels (UTM)</h4>
                                <span class="badge bg-light text-dark fw-bold">Attribution</span>
                            </div>
                            <div class="d-flex flex-column gap-2">
                                <t t-foreach="state.sources" t-as="src" t-key="src.name">
                                    <div class="d-flex justify-content-between align-items-center p-2 rounded-3 bg-light">
                                        <span class="fw-semibold text-dark small" t-esc="src.name"/>
                                        <span class="badge bg-primary rounded-pill fw-bold" t-esc="src.count"/>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- Temperature & Quality -->
                    <div class="col-12 col-lg-4">
                        <div class="diyacrm-card">
                            <div class="diyacrm-card-header">
                                <h4><i class="fa fa-fire text-danger"/> Lead Temperature</h4>
                                <span class="badge bg-light text-dark fw-bold">Quality</span>
                            </div>
                            <div class="diyacrm-temp-grid">
                                <div class="diyacrm-temp-box temp-box-hot">
                                    <div class="small fw-bold">🔥 HOT</div>
                                    <div class="temp-count"><t t-esc="state.temperature.hot"/></div>
                                </div>
                                <div class="diyacrm-temp-box temp-box-warm">
                                    <div class="small fw-bold">⛅ WARM</div>
                                    <div class="temp-count"><t t-esc="state.temperature.warm"/></div>
                                </div>
                                <div class="diyacrm-temp-box temp-box-cold">
                                    <div class="small fw-bold">❄️ COLD</div>
                                    <div class="temp-count"><t t-esc="state.temperature.cold"/></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Team Leaderboard -->
                    <div class="col-12 col-lg-4">
                        <div class="diyacrm-card">
                            <div class="diyacrm-card-header">
                                <h4><i class="fa fa-ranking-star text-primary"/> Sales Team Performance</h4>
                                <span class="badge bg-light text-dark fw-bold">Team KPIs</span>
                            </div>
                            <div class="table-responsive">
                                <table class="diyacrm-table">
                                    <thead>
                                        <tr>
                                            <th>Salesperson</th>
                                            <th>Opps</th>
                                            <th>Visits</th>
                                            <th>Won</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="state.leaderboard" t-as="user" t-key="user.id">
                                            <tr>
                                                <td>
                                                    <span class="diyacrm-user-avatar" t-esc="user.avatar"/>
                                                    <strong class="text-dark" t-esc="user.name"/>
                                                </td>
                                                <td><span class="badge bg-light text-dark fw-bold" t-esc="user.new_opps"/></td>
                                                <td><strong class="text-dark" t-esc="user.visits_done"/></td>
                                                <td><span class="badge bg-success text-white fw-bold" t-esc="user.won"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </t>

</templates>
