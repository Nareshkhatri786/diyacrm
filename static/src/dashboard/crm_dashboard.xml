<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="diyacrm.CrmExecutiveDashboard">
        <div class="o_crm_dashboard_wrapper" style="height: 100%; overflow-y: auto; background-color: #f4f6f9; padding: 24px; font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #0f172a;">
            
            <style>
                .diyacrm-dashboard-container {
                    max-width: 1540px;
                    margin: 0 auto;
                }

                /* Top Header &amp; Filters */
                .diyacrm-header-card {
                    background: #ffffff;
                    border-radius: 16px;
                    padding: 16px 24px;
                    box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
                    border: 1px solid #e2e8f0;
                    margin-bottom: 24px;
                    display: flex !important;
                    flex-direction: row !important;
                    justify-content: space-between !important;
                    align-items: center !important;
                    flex-wrap: wrap !important;
                    gap: 16px;
                }

                .diyacrm-header-title h1 {
                    font-size: 1.35rem;
                    font-weight: 800;
                    color: #0f172a;
                    display: flex;
                    align-items: center;
                    gap: 10px;
                    margin-bottom: 0;
                }

                .diyacrm-header-title p {
                    font-size: 0.82rem;
                    color: #64748b;
                    margin-top: 4px;
                    margin-bottom: 0;
                }

                .diyacrm-filter-group {
                    display: flex !important;
                    flex-direction: row !important;
                    align-items: center !important;
                    gap: 10px !important;
                    flex-wrap: nowrap !important;
                }

                .diyacrm-select-filter {
                    background: #f8fafc !important;
                    border: 1px solid #cbd5e1 !important;
                    color: #0f172a !important;
                    padding: 7px 12px !important;
                    border-radius: 8px !important;
                    font-size: 0.82rem !important;
                    font-weight: 600 !important;
                    cursor: pointer !important;
                    outline: none !important;
                    width: auto !important;
                    display: inline-block !important;
                    min-width: 130px !important;
                    height: 36px !important;
                }

                .diyacrm-select-filter:hover, .diyacrm-select-filter:focus {
                    border-color: #4f46e5 !important;
                    background: #ffffff !important;
                }

                .diyacrm-btn-live {
                    background: #10b981;
                    color: white;
                    padding: 7px 14px;
                    border-radius: 20px;
                    font-size: 0.75rem;
                    font-weight: 700;
                    display: inline-flex;
                    align-items: center;
                    gap: 6px;
                    white-space: nowrap;
                    height: 36px;
                }

                /* 6-Card KPI Grid */
                .diyacrm-kpi-grid {
                    display: grid;
                    grid-template-columns: repeat(6, 1fr);
                    gap: 16px;
                    margin-bottom: 24px;
                }

                .diyacrm-kpi-card {
                    background: #ffffff;
                    border-radius: 12px;
                    padding: 18px;
                    border: 1px solid #e2e8f0;
                    box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
                    position: relative;
                    overflow: hidden;
                    transition: transform 0.2s, box-shadow 0.2s;
                }

                .diyacrm-kpi-card:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
                }

                .diyacrm-kpi-card::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: 0;
                    right: 0;
                    height: 4px;
                }

                .kpi-calls::before { background: #4f46e5; }
                .kpi-new::before { background: #10b981; }
                .kpi-visit::before { background: #f59e0b; }
                .kpi-won::before { background: #8b5cf6; }
                .kpi-wa::before { background: #25d366; }
                .kpi-stale::before { background: #ef4444; }

                .diyacrm-kpi-header {
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    margin-bottom: 10px;
                }

                .diyacrm-kpi-title {
                    font-size: 0.72rem;
                    font-weight: 700;
                    color: #64748b;
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                }

                .diyacrm-kpi-icon-wrap {
                    width: 32px;
                    height: 32px;
                    border-radius: 8px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 0.9rem;
                    background: #f8fafc;
                    color: #475569;
                }

                .diyacrm-kpi-value {
                    font-size: 1.7rem;
                    font-weight: 800;
                    color: #0f172a;
                    line-height: 1.1;
                    margin-bottom: 8px;
                }

                .diyacrm-kpi-subtitle {
                    font-size: 0.75rem;
                    color: #64748b;
                    display: flex;
                    align-items: center;
                    gap: 6px;
                    flex-wrap: wrap;
                }

                .diyacrm-badge-pill {
                    display: inline-flex;
                    align-items: center;
                    gap: 4px;
                    padding: 2px 8px;
                    border-radius: 12px;
                    font-size: 0.72rem;
                    font-weight: 700;
                }

                .badge-green { background: #dcfce7; color: #15803d; }
                .badge-blue { background: #e0e7ff; color: #4338ca; }
                .badge-orange { background: #ffedd5; color: #c2410c; }
                .badge-red { background: #fee2e2; color: #991b1b; }
                .badge-purple { background: #f3e8ff; color: #7e22ce; }

                /* 2-Column Dashboard Rows */
                .diyacrm-dash-row {
                    display: grid;
                    grid-template-columns: repeat(2, 1fr);
                    gap: 20px;
                    margin-bottom: 24px;
                }

                .diyacrm-box-card {
                    background: #ffffff;
                    border-radius: 14px;
                    padding: 20px;
                    border: 1px solid #e2e8f0;
                    box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
                }

                .diyacrm-card-header {
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    margin-bottom: 16px;
                    border-bottom: 1px solid #f1f5f9;
                    padding-bottom: 10px;
                }

                .diyacrm-card-header h3 {
                    font-size: 0.95rem;
                    font-weight: 700;
                    color: #0f172a;
                    margin-bottom: 0;
                    display: flex;
                    align-items: center;
                    gap: 8px;
                }

                .diyacrm-card-tag {
                    font-size: 0.72rem;
                    font-weight: 700;
                    background: #f1f5f9;
                    color: #475569;
                    padding: 3px 8px;
                    border-radius: 6px;
                }

                /* Outcome Grid */
                .diyacrm-outcome-grid {
                    display: grid;
                    grid-template-columns: repeat(4, 1fr);
                    gap: 10px;
                    margin-top: 14px;
                }

                .diyacrm-outcome-box {
                    padding: 12px;
                    border-radius: 10px;
                    text-align: center;
                    border: 1px solid transparent;
                }

                .box-answered { background: #f0fdf4; border-color: #bbf7d0; color: #166534; }
                .box-noanswer { background: #fef2f2; border-color: #fecaca; color: #991b1b; }
                .box-busy { background: #fffbeb; border-color: #fde68a; color: #92400e; }
                .box-switched { background: #f8fafc; border-color: #e2e8f0; color: #475569; }

                .box-wa-campaign { background: #f5f3ff; border-color: #ddd6fe; color: #6d28d9; }
                .box-wa-connected { background: #f0fdf4; border-color: #bbf7d0; color: #166534; }
                .box-wa-missed { background: #fff7ed; border-color: #fed7aa; color: #c2410c; }
                .box-wa-replies { background: #eff6ff; border-color: #bfdbfe; color: #1d4ed8; }

                .diyacrm-outcome-count { font-size: 1.25rem; font-weight: 800; }
                .diyacrm-outcome-lbl { font-size: 0.7rem; font-weight: 600; text-transform: uppercase; margin-top: 2px; }

                /* Funnel Stages */
                .diyacrm-stage-funnel-list {
                    display: flex;
                    flex-direction: column;
                    gap: 10px;
                }

                .diyacrm-stage-row {
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    gap: 12px;
                    font-size: 0.82rem;
                }

                .diyacrm-stage-name {
                    width: 170px;
                    font-weight: 600;
                    color: #334155;
                }

                .diyacrm-stage-bar-wrap {
                    flex-grow: 1;
                    height: 10px;
                    background: #f1f5f9;
                    border-radius: 5px;
                    overflow: hidden;
                }

                .diyacrm-stage-bar {
                    height: 100%;
                    border-radius: 5px;
                    transition: width 0.5s ease;
                }

                .diyacrm-stage-val {
                    width: 50px;
                    text-align: right;
                    font-weight: 700;
                    color: #0f172a;
                }

                /* Leaderboard Table */
                .diyacrm-leaderboard-table {
                    width: 100%;
                    border-collapse: collapse;
                    font-size: 0.82rem;
                }

                .diyacrm-leaderboard-table th {
                    background: #f8fafc;
                    color: #64748b;
                    font-weight: 700;
                    text-transform: uppercase;
                    font-size: 0.7rem;
                    letter-spacing: 0.5px;
                    padding: 10px 14px;
                    text-align: left;
                    border-bottom: 1px solid #e2e8f0;
                }

                .diyacrm-leaderboard-table td {
                    padding: 12px 14px;
                    border-bottom: 1px solid #f1f5f9;
                    color: #334155;
                    font-weight: 500;
                }

                .diyacrm-leaderboard-table tr:hover td {
                    background: #f8fafc;
                }

                .diyacrm-user-cell {
                    display: flex;
                    align-items: center;
                    gap: 10px;
                    font-weight: 700;
                    color: #0f172a;
                }

                .diyacrm-user-avatar {
                    width: 28px;
                    height: 28px;
                    border-radius: 50%;
                    background: #eef2ff;
                    color: #4f46e5;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 0.75rem;
                    font-weight: 700;
                }

                /* Temperature Grid */
                .diyacrm-temp-grid {
                    display: grid;
                    grid-template-columns: repeat(3, 1fr);
                    gap: 12px;
                }

                .diyacrm-temp-card {
                    border-radius: 10px;
                    padding: 14px;
                    text-align: center;
                    cursor: pointer;
                    transition: transform 0.2s, box-shadow 0.2s;
                }
                .diyacrm-temp-card:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
                }

                .temp-hot { background: #fff1f2; border: 1px solid #fecdd3; color: #be123c; }
                .temp-warm { background: #fffbeb; border: 1px solid #fde68a; color: #b45309; }
                .temp-cold { background: #ecfeff; border: 1px solid #a5f3fc; color: #0e7490; }

                .diyacrm-temp-val { font-size: 1.35rem; font-weight: 800; margin-top: 4px; }

                /* Site Visit Funnel Boxes */
                .diyacrm-sv-grid {
                    display: grid;
                    grid-template-columns: repeat(4, 1fr);
                    gap: 10px;
                    margin-bottom: 16px;
                }
                .diyacrm-sv-box {
                    padding: 12px;
                    border-radius: 10px;
                    text-align: center;
                    border: 1px solid #e2e8f0;
                    background: #f8fafc;
                }
                .diyacrm-sv-box.box-hot {
                    background: #fff1f2;
                    border-color: #fecdd3;
                    color: #be123c;
                    cursor: pointer;
                }
                .diyacrm-sv-box.box-active {
                    background: #f0fdf4;
                    border-color: #bbf7d0;
                    color: #15803d;
                    cursor: pointer;
                }
                .diyacrm-sv-box.box-won {
                    background: #f5f3ff;
                    border-color: #ddd6fe;
                    color: #7e22ce;
                }

                @media (max-width: 1400px) {
                    .diyacrm-kpi-grid { grid-template-columns: repeat(3, 1fr); }
                }
                @media (max-width: 900px) {
                    .diyacrm-dash-row { grid-template-columns: 1fr; }
                    .diyacrm-kpi-grid { grid-template-columns: repeat(2, 1fr); }
                    .diyacrm-outcome-grid, .diyacrm-sv-grid { grid-template-columns: repeat(2, 1fr); }
                    .diyacrm-filter-group { flex-wrap: wrap !important; }
                }
            </style>

            <div class="diyacrm-dashboard-container">

                <!-- 1. Top Header Bar with Global Filters -->
                <div class="diyacrm-header-card">
                    <div class="diyacrm-header-title">
                        <h1><i class="fa fa-chart-line text-primary"/> Diya CRM - Real Estate Executive Dashboard</h1>
                        <p>Live Calls, Site Visit Conversions, Hot Prospects, WhatsApp Campaigns &amp; Team Tracking</p>
                    </div>

                    <div class="diyacrm-filter-group">
                        <span class="diyacrm-btn-live"><i class="fa fa-circle text-white"/> Live Pipeline</span>
                        
                        <!-- Project Selector -->
                        <select class="diyacrm-select-filter" t-on-change="onCompanyChange">
                            <option value="all">🏢 All Projects</option>
                            <t t-foreach="state.availableCompanies" t-as="comp" t-key="comp.id">
                                <option t-att-value="comp.id" t-esc="comp.name"/>
                            </t>
                        </select>

                        <!-- Date Range Selector -->
                        <select class="diyacrm-select-filter" t-on-change="onPeriodChange">
                            <option value="today">📅 Today</option>
                            <option value="yesterday">📅 Yesterday</option>
                            <option value="48h" selected="selected">📅 Last 48 Hours</option>
                            <option value="week">📅 This Week</option>
                            <option value="month">📅 This Month</option>
                            <option value="all">📅 All Time</option>
                        </select>

                        <!-- Salesperson Selector -->
                        <select class="diyacrm-select-filter" t-on-change="onUserChange">
                            <option value="all">👤 All Sales Team</option>
                            <t t-foreach="state.leaderboard" t-as="user" t-key="user.id">
                                <option t-att-value="user.id" t-esc="user.name"/>
                            </t>
                        </select>

                        <button class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1 shadow-sm rounded-2" style="padding: 7px 14px; height: 36px; white-space: nowrap;" t-on-click="loadDashboardData">
                            <i class="fa fa-sync-alt" t-att-class="{'fa-spin': state.loading}"/>
                            <span>Refresh</span>
                        </button>
                    </div>
                </div>

                <!-- 2. Hero KPI Cards (6 Grid) -->
                <div class="diyacrm-kpi-grid">
                    <!-- KPI 1: Calls -->
                    <div class="diyacrm-kpi-card kpi-calls">
                        <div class="diyacrm-kpi-header">
                            <span class="diyacrm-kpi-title">Total Calls</span>
                            <div class="diyacrm-kpi-icon-wrap"><i class="fa fa-phone"/></div>
                        </div>
                        <div class="diyacrm-kpi-value"><t t-esc="state.kpis.total_calls"/></div>
                        <div class="diyacrm-kpi-subtitle">
                            <span class="diyacrm-badge-pill badge-green"><i class="fa fa-check"/> <t t-esc="state.kpis.connected_pct"/>% Connected</span>
                        </div>
                    </div>

                    <!-- KPI 2: Fresh Inquiries -->
                    <div class="diyacrm-kpi-card kpi-new cursor-pointer" t-on-click="() => this.openOpportunities('new')">
                        <div class="diyacrm-kpi-header">
                            <span class="diyacrm-kpi-title">New Opps</span>
                            <div class="diyacrm-kpi-icon-wrap"><i class="fa fa-user-plus"/></div>
                        </div>
                        <div class="diyacrm-kpi-value"><t t-esc="state.kpis.new_opps"/></div>
                        <div class="diyacrm-kpi-subtitle">
                            <span class="diyacrm-badge-pill badge-blue">Fresh Inquiries</span>
                        </div>
                    </div>

                    <!-- KPI 3: Site Visits Funnel (Total -> Active -> Hot) -->
                    <div class="diyacrm-kpi-card kpi-visit cursor-pointer" t-on-click="() => this.openOpportunities('visited_hot')">
                        <div class="diyacrm-kpi-header">
                            <span class="diyacrm-kpi-title">Visits Done</span>
                            <div class="diyacrm-kpi-icon-wrap"><i class="fa fa-person-walking"/></div>
                        </div>
                        <div class="diyacrm-kpi-value"><t t-esc="state.site_visit_funnel.total_visited"/></div>
                        <div class="diyacrm-kpi-subtitle">
                            <span class="diyacrm-badge-pill badge-orange"><t t-esc="state.site_visit_funnel.active_visited"/> Active</span>
                            <span class="diyacrm-badge-pill badge-red fw-bold">🔥 <t t-esc="state.site_visit_funnel.hot_visited"/> Hot</span>
                        </div>
                    </div>

                    <!-- KPI 4: Won Bookings -->
                    <div class="diyacrm-kpi-card kpi-won cursor-pointer" t-on-click="() => this.openOpportunities('won')">
                        <div class="diyacrm-kpi-header">
                            <span class="diyacrm-kpi-title">Won Bookings</span>
                            <div class="diyacrm-kpi-icon-wrap"><i class="fa fa-trophy"/></div>
                        </div>
                        <div class="diyacrm-kpi-value"><t t-esc="state.kpis.won"/></div>
                        <div class="diyacrm-kpi-subtitle">
                            <span class="diyacrm-badge-pill badge-purple"><t t-esc="state.kpis.won_all_time"/> Lifetime Won</span>
                        </div>
                    </div>

                    <!-- KPI 5: WhatsApp Outreach -->
                    <div class="diyacrm-kpi-card kpi-wa">
                        <div class="diyacrm-kpi-header">
                            <span class="diyacrm-kpi-title">WhatsApp Outreach</span>
                            <div class="diyacrm-kpi-icon-wrap" style="color: #16a34a;"><i class="fa fa-comments"/></div>
                        </div>
                        <div class="diyacrm-kpi-value"><t t-esc="state.whatsapp_analytics.total_sent"/></div>
                        <div class="diyacrm-kpi-subtitle">
                            <span class="diyacrm-badge-pill badge-green"><i class="fa fa-reply"/> <t t-esc="state.whatsapp_analytics.response_rate_pct"/>% Replies (<t t-esc="state.whatsapp_analytics.total_received"/>)</span>
                        </div>
                    </div>

                    <!-- KPI 6: Stale / Untouched Leads -->
                    <div class="diyacrm-kpi-card kpi-stale cursor-pointer" t-on-click="() => this.openOpportunities('stale')">
                        <div class="diyacrm-kpi-header">
                            <span class="diyacrm-kpi-title">Needs Attention</span>
                            <div class="diyacrm-kpi-icon-wrap" style="color: #dc2626;"><i class="fa fa-triangle-exclamation"/></div>
                        </div>
                        <div class="diyacrm-kpi-value" style="color: #dc2626;"><t t-esc="state.conversion_rates.stale_leads"/></div>
                        <div class="diyacrm-kpi-subtitle">
                            <span class="diyacrm-badge-pill badge-red"><i class="fa fa-clock"/> &gt;48h Untouched</span>
                        </div>
                    </div>
                </div>

                <!-- 3. Row 1: Calling Outcomes & 7-Stage Pipeline Funnel -->
                <div class="diyacrm-dash-row">
                    <!-- Call Outcome Analytics -->
                    <div class="diyacrm-box-card">
                        <div class="diyacrm-card-header">
                            <h3><i class="fa fa-headset text-primary"/> Calling Outcome Analytics</h3>
                            <span class="diyacrm-card-tag"><t t-esc="state.kpis.total_calls"/> Dials Logged</span>
                        </div>
                        <div style="height: 180px; position: relative;">
                            <canvas t-ref="callOutcomeChart"/>
                        </div>
                        <div class="diyacrm-outcome-grid">
                            <div class="diyacrm-outcome-box box-answered">
                                <div class="diyacrm-outcome-count"><t t-esc="state.calling_outcomes.answered"/></div>
                                <div class="diyacrm-outcome-lbl">Answered (<t t-esc="state.calling_outcomes.answered_pct"/>%)</div>
                            </div>
                            <div class="diyacrm-outcome-box box-noanswer">
                                <div class="diyacrm-outcome-count"><t t-esc="state.calling_outcomes.no_answer"/></div>
                                <div class="diyacrm-outcome-lbl">No Answer (<t t-esc="state.calling_outcomes.no_answer_pct"/>%)</div>
                            </div>
                            <div class="diyacrm-outcome-box box-busy">
                                <div class="diyacrm-outcome-count"><t t-esc="state.calling_outcomes.busy"/></div>
                                <div class="diyacrm-outcome-lbl">Busy (<t t-esc="state.calling_outcomes.busy_pct"/>%)</div>
                            </div>
                            <div class="diyacrm-outcome-box box-switched">
                                <div class="diyacrm-outcome-count"><t t-esc="state.calling_outcomes.switched_off"/></div>
                                <div class="diyacrm-outcome-lbl">Switched Off (<t t-esc="state.calling_outcomes.switched_off_pct"/>%)</div>
                            </div>
                        </div>
                    </div>

                    <!-- 7-Stage Pipeline Funnel -->
                    <div class="diyacrm-box-card">
                        <div class="diyacrm-card-header">
                            <h3><i class="fa fa-filter text-primary"/> 7-Stage Active Pipeline Funnel</h3>
                            <span class="diyacrm-card-tag">Active Opportunities</span>
                        </div>
                        <div class="diyacrm-stage-funnel-list">
                            <t t-foreach="state.stages" t-as="stg" t-key="stg.id">
                                <div class="diyacrm-stage-row">
                                    <span class="diyacrm-stage-name" t-esc="stg.name"/>
                                    <div class="diyacrm-stage-bar-wrap">
                                        <div class="diyacrm-stage-bar" t-attf-style="width: #{stg.pct}%; background-color: #{stg.color};"/>
                                    </div>
                                    <span class="diyacrm-stage-val" t-esc="stg.count"/>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>

                <!-- 4. Row 2: Inbound Sources & WhatsApp Campaigns/Follow-up Analytics -->
                <div class="diyacrm-dash-row">
                    <!-- Source Breakdown -->
                    <div class="diyacrm-box-card">
                        <div class="diyacrm-card-header">
                            <h3><i class="fa fa-bullhorn text-primary"/> Lead Inbound Channels (UTM Sources)</h3>
                            <span class="diyacrm-card-tag">Attribution</span>
                        </div>
                        <div style="height: 220px; position: relative;">
                            <canvas t-ref="sourceChart"/>
                        </div>
                    </div>

                    <!-- WhatsApp Campaigns & After-Call Response Analytics -->
                    <div class="diyacrm-box-card">
                        <div class="diyacrm-card-header">
                            <h3><i class="fa fa-comments text-success"/> WhatsApp Campaigns &amp; Automated Follow-up</h3>
                            <span class="diyacrm-card-tag"><t t-esc="state.whatsapp_analytics.total_sent"/> Delivered</span>
                        </div>
                        <div class="diyacrm-outcome-grid" style="margin-top: 6px;">
                            <div class="diyacrm-outcome-box box-wa-campaign">
                                <div class="diyacrm-outcome-count"><t t-esc="state.whatsapp_analytics.campaign_sent"/></div>
                                <div class="diyacrm-outcome-lbl">🚀 Bulk Stage Campaigns</div>
                            </div>
                            <div class="diyacrm-outcome-box box-wa-connected">
                                <div class="diyacrm-outcome-count"><t t-esc="state.whatsapp_analytics.call_connected_sent"/></div>
                                <div class="diyacrm-outcome-lbl">📞 Call Connected Follow-up</div>
                            </div>
                            <div class="diyacrm-outcome-box box-wa-missed">
                                <div class="diyacrm-outcome-count"><t t-esc="state.whatsapp_analytics.call_missed_sent"/></div>
                                <div class="diyacrm-outcome-lbl">📵 Missed / Busy Follow-up</div>
                            </div>
                            <div class="diyacrm-outcome-box box-wa-replies">
                                <div class="diyacrm-outcome-count"><t t-esc="state.whatsapp_analytics.total_received"/></div>
                                <div class="diyacrm-outcome-lbl">💬 Inbound Client Replies (<t t-esc="state.whatsapp_analytics.response_rate_pct"/>%)</div>
                            </div>
                        </div>
                        <div class="mt-3 p-2 bg-light rounded text-muted small d-flex justify-content-between align-items-center">
                            <span><i class="fa fa-shield-alt text-primary"/> Meta Cloud API Connected • 12h Auto Anti-Spam Guard Active</span>
                            <span class="fw-bold text-dark"><t t-esc="state.whatsapp_analytics.direct_sent"/> Direct 1-to-1 Msgs</span>
                        </div>
                    </div>
                </div>

                <!-- 5. Row 3: Active Lead Temperature & Site Visit Conversion Funnel -->
                <div class="diyacrm-dash-row">
                    <!-- Temperature (Strictly Active Leads) -->
                    <div class="diyacrm-box-card">
                        <div class="diyacrm-card-header">
                            <div>
                                <h3><i class="fa fa-fire text-danger"/> Lead Temperature (Active Pipeline)</h3>
                                <div class="text-muted small mt-1" style="font-size: 0.72rem;">Strictly open active opportunities (Won &amp; Lost excluded)</div>
                            </div>
                            <span class="diyacrm-card-tag"><t t-esc="state.temperature.total_active"/> Active Leads</span>
                        </div>
                        <div class="diyacrm-temp-grid mb-3">
                            <div class="diyacrm-temp-card temp-hot" t-on-click="() => this.openOpportunities('hot')">
                                <div>🔥 <strong>HOT</strong> (&lt; 30 Days)</div>
                                <div class="diyacrm-temp-val"><t t-esc="state.temperature.hot"/> Leads</div>
                            </div>
                            <div class="diyacrm-temp-card temp-warm" t-on-click="() => this.openOpportunities('warm')">
                                <div>⛅ <strong>WARM</strong> (1-2 Months)</div>
                                <div class="diyacrm-temp-val"><t t-esc="state.temperature.warm"/> Leads</div>
                            </div>
                            <div class="diyacrm-temp-card temp-cold" t-on-click="() => this.openOpportunities('cold')">
                                <div>❄️ <strong>COLD</strong> (Exploring)</div>
                                <div class="diyacrm-temp-val"><t t-esc="state.temperature.cold"/> Leads</div>
                            </div>
                        </div>
                        <div style="height: 140px; position: relative;">
                            <canvas t-ref="tempChart"/>
                        </div>
                    </div>

                    <!-- Site Visit Conversion Funnel & Ground Feedback -->
                    <div class="diyacrm-box-card">
                        <div class="diyacrm-card-header">
                            <div>
                                <h3><i class="fa fa-person-walking text-primary"/> Site Visit Conversion &amp; Ground Feedback</h3>
                                <div class="text-muted small mt-1" style="font-size: 0.72rem;">Visits to Active Follow-up &amp; Hot Prospect Conversion</div>
                            </div>
                            <span class="diyacrm-card-tag"><t t-esc="state.site_visit_funnel.total_visited"/> Visits Done</span>
                        </div>

                        <!-- Visited Funnel Grid -->
                        <div class="diyacrm-sv-grid">
                            <div class="diyacrm-sv-box">
                                <div class="fw-bold fs-5 text-dark"><t t-esc="state.site_visit_funnel.total_visited"/></div>
                                <div class="text-muted small text-uppercase" style="font-size: 0.68rem;">Visits Completed</div>
                            </div>
                            <div class="diyacrm-sv-box box-active cursor-pointer" t-on-click="() => this.openOpportunities('visited_active')">
                                <div class="fw-bold fs-5"><t t-esc="state.site_visit_funnel.active_visited"/></div>
                                <div class="small text-uppercase fw-bold" style="font-size: 0.68rem;">Still Active (<t t-esc="state.site_visit_funnel.active_pct"/>%)</div>
                            </div>
                            <div class="diyacrm-sv-box box-hot cursor-pointer" t-on-click="() => this.openOpportunities('visited_hot')">
                                <div class="fw-bold fs-5">🔥 <t t-esc="state.site_visit_funnel.hot_visited"/></div>
                                <div class="small text-uppercase fw-bold" style="font-size: 0.68rem;">Active Hot (<t t-esc="state.site_visit_funnel.hot_pct"/>%)</div>
                            </div>
                            <div class="diyacrm-sv-box box-won">
                                <div class="fw-bold fs-5">🏆 <t t-esc="state.site_visit_funnel.won_visited"/></div>
                                <div class="small text-uppercase fw-bold" style="font-size: 0.68rem;">Won Bookings</div>
                            </div>
                        </div>

                        <!-- Ground Survey Insights (Dynamic, Real Data Only) -->
                        <div t-if="state.site_visit_insights.has_data" style="font-size: 0.82rem; display: flex; flex-direction: column; gap: 10px;">
                            <div>
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted fw-bold">Finance Mode:</span>
                                    <span class="fw-bold">Loan: <t t-esc="state.site_visit_insights.loan_pct"/>% | Cash: <t t-esc="state.site_visit_insights.cash_pct"/>%</span>
                                </div>
                                <div class="diyacrm-stage-bar-wrap"><div class="diyacrm-stage-bar" t-att-style="'width: ' + state.site_visit_insights.loan_pct + '%; background: #06b6d4;'"/></div>
                            </div>

                            <div>
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted fw-bold">Purchase Timeline (&lt;30 Days):</span>
                                    <span class="fw-bold"><t t-esc="state.site_visit_insights.timeline_pct"/>% Immediate</span>
                                </div>
                                <div class="diyacrm-stage-bar-wrap"><div class="diyacrm-stage-bar" t-att-style="'width: ' + state.site_visit_insights.timeline_pct + '%; background: #10b981;'"/></div>
                            </div>

                            <div>
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted fw-bold">Budget Fit:</span>
                                    <span class="fw-bold"><t t-esc="state.site_visit_insights.budget_pct"/>% Within Budget</span>
                                </div>
                                <div class="diyacrm-stage-bar-wrap"><div class="diyacrm-stage-bar" t-att-style="'width: ' + state.site_visit_insights.budget_pct + '%; background: #f59e0b;'"/></div>
                            </div>
                        </div>
                        <div t-else="" class="p-3 bg-light rounded text-center text-muted small">
                            <i class="fa fa-clipboard-check text-secondary mb-1 d-block fs-5"/>
                            <span>No site visit survey submitted yet for selected filter. Feedback will show here once executives submit visit forms.</span>
                        </div>
                    </div>
                </div>

                <!-- 6. Row 4: Sales Executive Leaderboard -->
                <div class="diyacrm-dash-row-3" style="margin-bottom: 24px;">
                    <div class="diyacrm-box-card">
                        <div class="diyacrm-card-header">
                            <h3><i class="fa fa-ranking-star text-primary"/> Sales Executive Leaderboard &amp; Performance</h3>
                            <span class="diyacrm-card-tag">Team KPI Tracker</span>
                        </div>
                        <div style="overflow-x: auto;">
                            <table class="diyacrm-leaderboard-table">
                                <thead>
                                    <tr>
                                        <th>Salesperson</th>
                                        <th>Project</th>
                                        <th>Calls Made</th>
                                        <th>New Opps</th>
                                        <th>Visits Done</th>
                                        <th>Won Bookings</th>
                                        <th>Pending Follow-ups</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.leaderboard" t-as="user" t-key="user.id">
                                        <tr>
                                            <td>
                                                <div class="diyacrm-user-cell">
                                                    <div class="diyacrm-user-avatar" t-esc="user.avatar"/>
                                                    <span t-esc="user.name"/>
                                                </div>
                                            </td>
                                            <td><span class="diyacrm-badge-pill badge-blue" t-esc="user.project"/></td>
                                            <td><strong><t t-esc="user.calls"/></strong></td>
                                            <td><span class="diyacrm-badge-pill badge-green">+<t t-esc="user.new_opps"/></span></td>
                                            <td><strong><t t-esc="user.visits_done"/></strong></td>
                                            <td><span class="diyacrm-badge-pill badge-green fw-bold">🏆 <t t-esc="user.won"/></span></td>
                                            <td><span class="diyacrm-badge-pill badge-orange"><t t-esc="user.pending_overdue"/> Due</span></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </t>

</templates>
