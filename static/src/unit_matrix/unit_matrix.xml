<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="diyacrm.CrmUnitMatrix">
        <div class="o_unit_matrix_container bg-light h-100 overflow-auto p-3 p-md-4">
            <!-- 1. Header Bar -->
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 bg-white p-3 rounded-3 shadow-sm border">
                <div class="d-flex align-items-center gap-3">
                    <div class="matrix-icon-badge bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 46px; height: 46px;">
                        <i class="fa fa-building fa-lg"/>
                    </div>
                    <div>
                        <h4 class="mb-0 fw-bold text-dark">
                            <t t-esc="state.data.company_name"/> - Unit Availability Matrix
                        </h4>
                        <div class="text-muted small">
                            Real-time floor-wise inventory tracking, facing &amp; direct booking
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
                    <button class="btn btn-outline-secondary btn-sm" t-on-click="() => this.loadMatrixData()">
                        <i class="fa fa-refresh me-1"/> Refresh
                    </button>
                    <button class="btn btn-primary btn-sm" t-on-click="() => this.openListView()">
                        <i class="fa fa-table me-1"/> 📋 Table / List View
                    </button>
                </div>
            </div>

            <!-- 2. KPI Summary Cards -->
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-3">
                    <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-primary">
                        <div class="text-muted small fw-semibold text-uppercase">Total Units</div>
                        <div class="fs-3 fw-bold text-dark mt-1"><t t-esc="state.data.total_count"/></div>
                        <div class="small text-muted mt-1">Across all blocks</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-success">
                        <div class="text-muted small fw-semibold text-uppercase">🟢 Available / Open</div>
                        <div class="fs-3 fw-bold text-success mt-1"><t t-esc="state.data.available_count"/></div>
                        <div class="small text-muted mt-1 d-flex flex-wrap gap-1">
                            <t t-foreach="state.data.available_sizes || []" t-as="sz" t-key="sz">
                                <span class="badge bg-success-subtle text-success">
                                    <t t-esc="sz"/>y: <t t-esc="state.data.size_stats[sz] || 0"/>
                                </span>
                            </t>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-danger">
                        <div class="text-muted small fw-semibold text-uppercase">🔴 Booked Units</div>
                        <div class="fs-3 fw-bold text-danger mt-1"><t t-esc="state.data.booked_count"/></div>
                        <div class="small text-muted mt-1">Confirmed with clients</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-warning">
                        <div class="text-muted small fw-semibold text-uppercase">🟡 In Discussion / Hold</div>
                        <div class="fs-3 fw-bold text-warning mt-1"><t t-esc="state.data.hold_count"/></div>
                        <div class="small text-muted mt-1">Temporary lock</div>
                    </div>
                </div>
            </div>

            <!-- 3. Block Tabs & Filters Container -->
            <div t-if="state.data.blocks and state.data.blocks.length > 0" class="bg-white p-3 rounded-3 shadow-sm border mb-4">
                <!-- Block Selector Tabs -->
                <div class="d-flex flex-wrap align-items-center justify-content-between border-bottom pb-3 mb-3 gap-2">
                    <div class="d-flex gap-2">
                        <t t-foreach="state.data.blocks" t-as="b" t-key="b">
                            <button t-attf-class="btn px-4 py-2 fw-bold #{state.activeBlock === b ? 'btn-dark' : 'btn-outline-secondary'}"
                                    t-on-click="() => this.switchBlock(b)">
                                <i class="fa fa-building-o me-2"/>
                                Block <t t-esc="b"/>
                                <span t-if="state.data.block_data[b]" class="badge bg-success ms-2">
                                    <t t-esc="state.data.block_data[b].available"/> Available
                                </span>
                            </button>
                        </t>
                    </div>

                    <!-- Search Input -->
                    <div class="position-relative" style="min-width: 240px;">
                        <input type="text" class="form-control form-control-sm ps-4 rounded-pill" 
                               placeholder="🔍 Search Unit No / Buyer..." 
                               t-on-input="(ev) => this.onSearchInput(ev)"/>
                    </div>
                </div>

                <!-- Filters Strip -->
                <div class="d-flex flex-wrap align-items-center gap-3">
                    <!-- Size Filter (Dynamic per Company) -->
                    <div class="d-flex align-items-center gap-1">
                        <span class="small fw-bold text-muted me-1">Size:</span>
                        <div class="btn-group btn-group-sm" role="group">
                            <button t-attf-class="btn #{state.filterSize === 'all' ? 'btn-primary' : 'btn-outline-secondary'}" t-on-click="() => this.setSizeFilter('all')">All</button>
                            <t t-foreach="state.data.available_sizes || []" t-as="sz" t-key="sz">
                                <button t-attf-class="btn #{state.filterSize === sz ? 'btn-primary' : 'btn-outline-secondary'}" t-on-click="() => this.setSizeFilter(sz)">
                                    <t t-esc="sz"/> Yd
                                </button>
                            </t>
                        </div>
                    </div>

                    <!-- Facing Filter -->
                    <div class="d-flex align-items-center gap-1">
                        <span class="small fw-bold text-muted me-1">Facing:</span>
                        <div class="btn-group btn-group-sm" role="group">
                            <button t-attf-class="btn #{state.filterFacing === 'all' ? 'btn-primary' : 'btn-outline-secondary'}" t-on-click="() => this.setFacingFilter('all')">All</button>
                            <button t-attf-class="btn #{state.filterFacing === 'garden_view' ? 'btn-primary' : 'btn-outline-secondary'}" t-on-click="() => this.setFacingFilter('garden_view')">🌳 Garden</button>
                            <button t-attf-class="btn #{state.filterFacing === 'main_road' ? 'btn-primary' : 'btn-outline-secondary'}" t-on-click="() => this.setFacingFilter('main_road')">🛣️ Main Road</button>
                            <button t-attf-class="btn #{state.filterFacing === 'internal_road' ? 'btn-primary' : 'btn-outline-secondary'}" t-on-click="() => this.setFacingFilter('internal_road')">🏘️ Internal Road</button>
                            <button t-attf-class="btn #{state.filterFacing === 'project_facing' ? 'btn-primary' : 'btn-outline-secondary'}" t-on-click="() => this.setFacingFilter('project_facing')">🏢 Project</button>
                            <button t-attf-class="btn #{state.filterFacing === 'plot_facing' ? 'btn-primary' : 'btn-outline-secondary'}" t-on-click="() => this.setFacingFilter('plot_facing')">🏞️ Plot</button>
                        </div>
                    </div>

                    <!-- PLC Filter -->
                    <div class="d-flex align-items-center gap-1">
                        <span class="small fw-bold text-muted me-1">PLC:</span>
                        <div class="btn-group btn-group-sm" role="group">
                            <button t-attf-class="btn #{state.filterPlc === 'all' ? 'btn-primary' : 'btn-outline-secondary'}" t-on-click="() => this.setPlcFilter('all')">All</button>
                            <button t-attf-class="btn #{state.filterPlc === 'yes' ? 'btn-primary' : 'btn-outline-secondary'}" t-on-click="() => this.setPlcFilter('yes')">⭐ With PLC</button>
                            <button t-attf-class="btn #{state.filterPlc === 'no' ? 'btn-primary' : 'btn-outline-secondary'}" t-on-click="() => this.setPlcFilter('no')">No PLC</button>
                        </div>
                    </div>

                    <!-- Status Filter -->
                    <div class="d-flex align-items-center gap-1 ms-auto">
                        <span class="small fw-bold text-muted me-1">Status:</span>
                        <div class="btn-group btn-group-sm" role="group">
                            <button t-attf-class="btn #{state.filterStatus === 'all' ? 'btn-primary' : 'btn-outline-secondary'}" t-on-click="() => this.setStatusFilter('all')">All</button>
                            <button t-attf-class="btn #{state.filterStatus === 'available' ? 'btn-success' : 'btn-outline-success'}" t-on-click="() => this.setStatusFilter('available')">🟢 Available Only</button>
                            <button t-attf-class="btn #{state.filterStatus === 'booked' ? 'btn-danger' : 'btn-outline-danger'}" t-on-click="() => this.setStatusFilter('booked')">🔴 Booked Only</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 4. Interactive Stacking Plan (Floors & Unit Cards) -->
            <div t-if="state.loading" class="text-center py-5">
                <i class="fa fa-circle-o-notch fa-spin fa-3x text-primary mb-3"/>
                <div class="text-muted fs-5">Loading Unit Inventory Matrix...</div>
            </div>

            <!-- Empty State when Company has no units registered yet -->
            <div t-elif="!state.loading and (!state.data.blocks or state.data.blocks.length === 0)" class="card p-5 text-center bg-white shadow-sm border rounded-3 my-4">
                <div class="mb-3">
                    <i class="fa fa-building-o fa-4x text-muted opacity-50"/>
                </div>
                <h4 class="fw-bold text-dark">No Units Registered for <t t-esc="state.data.company_name"/></h4>
                <p class="text-muted">
                    Currently there are no property units uploaded for this project/company. Units are strictly company-separated.
                </p>
                <div class="mt-2">
                    <button class="btn btn-primary btn-sm" t-on-click="() => this.openListView()">
                        <i class="fa fa-plus me-1"/> Go to All Units to Add Units
                    </button>
                </div>
            </div>

            <div t-elif="state.data.block_data[state.activeBlock]" class="stacking-plan-wrapper">
                <t t-set="blockObj" t-value="state.data.block_data[state.activeBlock]"/>

                <t t-foreach="blockObj.floors" t-as="flGroup" t-key="flGroup.floor">
                    <div class="floor-row-card bg-white p-3 rounded-3 shadow-sm border mb-3">
                        <div class="d-flex flex-wrap align-items-center gap-3">
                            <!-- Floor Label Badge -->
                            <div class="floor-label-badge text-center py-2 px-3 rounded-2 bg-light border" style="min-width: 105px;">
                                <div class="text-muted small fw-bold text-uppercase">Floor</div>
                                <div class="fs-5 fw-bold text-dark"><t t-esc="flGroup.floor_label || flGroup.floor"/></div>
                            </div>

                            <!-- Units Cards Grid for this Floor -->
                            <div class="d-flex flex-wrap gap-2 flex-grow-1 align-items-stretch">
                                <t t-foreach="flGroup.units" t-as="unit" t-key="unit.id">
                                    <div t-if="isUnitVisible(unit)"
                                         t-attf-class="unit-card-box rounded-3 p-3 border transition cursor-pointer position-relative #{unit.status === 'available' ? 'unit-available border-success' : unit.status === 'booked' ? 'unit-booked border-danger bg-light' : 'unit-hold border-warning'}"
                                         t-on-click="() => this.onUnitClick(unit)"
                                         t-att-title="unit.status === 'available' ? 'Click to Book this Unit' : 'Click to View Booking Details'"
                                         style="min-width: 175px; max-width: 210px;">
                                        
                                        <!-- Top Row: Unit No & Status Badge -->
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="fs-5 fw-bold text-dark"><t t-esc="unit.name"/></span>
                                            <span t-if="unit.status === 'available'" class="badge bg-success-subtle text-success border border-success fw-bold px-2 py-1 small">
                                                🟢 OPEN
                                            </span>
                                            <span t-elif="unit.status === 'booked'" class="badge bg-danger-subtle text-danger border border-danger fw-bold px-2 py-1 small">
                                                🔴 BOOKED
                                            </span>
                                            <span t-else="" class="badge bg-warning-subtle text-warning border border-warning fw-bold px-2 py-1 small">
                                                🟡 HOLD
                                            </span>
                                        </div>

                                        <!-- Specifications: Size & Facing -->
                                        <div class="small text-muted mt-2">
                                            <div class="fw-bold text-primary mb-1">
                                                <i class="fa fa-arrows-alt me-1"/> <t t-esc="unit.size"/> Sq. Yards
                                            </div>
                                            <div class="text-dark small text-truncate">
                                                <t t-if="unit.facing === 'garden_view'"><i class="fa fa-tree text-success me-1"/> Garden View</t>
                                                <t t-elif="unit.facing === 'main_road'"><i class="fa fa-road text-primary me-1"/> Main Road</t>
                                                <t t-elif="unit.facing === 'internal_road'"><i class="fa fa-compass text-secondary me-1"/> Internal Road</t>
                                                <t t-elif="unit.facing === 'project_facing'"><i class="fa fa-building-o text-primary me-1"/> Project Facing</t>
                                                <t t-else=""><i class="fa fa-map-o text-secondary me-1"/> Plot Facing</t>
                                            </div>
                                            <div t-if="unit.plc" class="text-warning fw-bold small mt-1">
                                                <i class="fa fa-star me-1"/> PLC Applicable
                                            </div>
                                        </div>

                                        <!-- Bottom Action or Buyer Info -->
                                        <div class="border-top pt-2 mt-2">
                                            <t t-if="unit.status === 'available'">
                                                <div class="text-center text-success fw-bold small">
                                                    <i class="fa fa-hand-pointer-o me-1"/> Click to Book
                                                </div>
                                            </t>
                                            <t t-elif="unit.status === 'booked'">
                                                <div class="text-danger small fw-bold text-truncate">
                                                    <i class="fa fa-user me-1"/> <t t-esc="unit.buyer || 'Booked'"/>
                                                </div>
                                                <div t-if="unit.salesperson" class="text-muted small text-truncate" style="font-size: 11px;">
                                                    <i class="fa fa-id-badge me-1"/> <t t-esc="unit.salesperson"/>
                                                </div>
                                            </t>
                                            <t t-else="">
                                                <div class="text-warning small fw-bold text-center">
                                                    In Discussion
                                                </div>
                                            </t>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
