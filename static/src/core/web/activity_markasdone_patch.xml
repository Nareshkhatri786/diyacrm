<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.ActivityMarkAsDone" t-inherit-mode="extension">
        <xpath expr="//textarea" position="before">
            <!-- MODE SWITCHER TABS (Quick Switch between Call & Site Visit) -->
            <div class="d-flex mb-3 border-bottom pb-2 gap-2">
                <button type="button" 
                    t-attf-class="btn btn-sm flex-fill fw-semibold {{ state.activeTab === 'call' ? 'btn-primary' : 'btn-outline-secondary' }}"
                    t-on-click="() => this.setActiveTab('call')">
                    <i class="fa fa-phone me-1"/> Call Outcome
                </button>
                <button type="button" 
                    t-attf-class="btn btn-sm flex-fill fw-semibold {{ state.activeTab === 'site_visit' ? 'btn-primary' : 'btn-outline-secondary' }}"
                    t-on-click="() => this.setActiveTab('site_visit')">
                    <i class="fa fa-building me-1"/> Site Visit Outcome
                </button>
            </div>

            <!-- 1. CALL OUTCOME SECTION -->
            <div t-if="state.activeTab === 'call'" class="mb-3">
                <label class="form-label text-uppercase text-muted fw-bold small mb-2 d-block" style="letter-spacing: 0.5px; font-size: 0.75rem;">
                    Call Outcome <span class="text-primary">*</span>
                </label>
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <button type="button" 
                            t-attf-class="btn w-100 call-outcome-btn py-2 text-start d-flex align-items-center {{ selectedOutcome === 'Answered' ? 'active-outcome' : '' }}" 
                            t-on-click="() => this.selectOutcome('Answered')">
                            <i class="fa fa-check-circle-o me-2 fs-6 text-success"/>
                            <span class="fw-semibold small">Answered</span>
                        </button>
                    </div>
                    <div class="col-6">
                        <button type="button" 
                            t-attf-class="btn w-100 call-outcome-btn py-2 text-start d-flex align-items-center {{ selectedOutcome === 'No answer' ? 'active-outcome' : '' }}" 
                            t-on-click="() => this.selectOutcome('No answer')">
                            <i class="fa fa-times-circle-o me-2 fs-6 text-danger"/>
                            <span class="fw-semibold small">No answer</span>
                        </button>
                    </div>
                    <div class="col-6">
                        <button type="button" 
                            t-attf-class="btn w-100 call-outcome-btn py-2 text-start d-flex align-items-center {{ selectedOutcome === 'Busy' ? 'active-outcome' : '' }}" 
                            t-on-click="() => this.selectOutcome('Busy')">
                            <i class="fa fa-clock-o me-2 fs-6 text-warning"/>
                            <span class="fw-semibold small">Busy</span>
                        </button>
                    </div>
                    <div class="col-6">
                        <button type="button" 
                            t-attf-class="btn w-100 call-outcome-btn py-2 text-start d-flex align-items-center {{ selectedOutcome === 'Switched off' ? 'active-outcome' : '' }}" 
                            t-on-click="() => this.selectOutcome('Switched off')">
                            <i class="fa fa-ban me-2 fs-6 text-secondary"/>
                            <span class="fw-semibold small">Switched off</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- 2. SITE VISIT OUTCOME SECTION -->
            <div t-if="state.activeTab === 'site_visit'" class="mb-3">
                <!-- Dropdown Row 1 -->
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label text-uppercase text-muted fw-bold small mb-1" style="font-size: 0.7rem;">
                            Purchase Timeline
                        </label>
                        <select class="form-select form-select-sm" t-model="state.purchaseTimeline" t-on-change="onSiteVisitChange">
                            <option value="Not discussed">Not discussed</option>
                            <option value="7 din ke andar">7 din ke andar</option>
                            <option value="30 din ke andar">30 din ke andar</option>
                            <option value="1 month+ baad">1 month+ baad</option>
                            <option value="Just exploring">Just exploring</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label text-uppercase text-muted fw-bold small mb-1" style="font-size: 0.7rem;">
                            Finance Mode
                        </label>
                        <select class="form-select form-select-sm" t-model="state.financeMode" t-on-change="onSiteVisitChange">
                            <option value="Not discussed">Not discussed</option>
                            <option value="Loan">Loan</option>
                            <option value="Cash">Cash</option>
                            <option value="Cash + Loan">Cash + Loan</option>
                            <option value="Not decided">Not decided</option>
                        </select>
                    </div>
                </div>

                <!-- Dropdown Row 2 -->
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label text-uppercase text-muted fw-bold small mb-1" style="font-size: 0.7rem;">
                            Budget Comfort
                        </label>
                        <select class="form-select form-select-sm" t-model="state.budgetComfort" t-on-change="onSiteVisitChange">
                            <option value="Not discussed">Not discussed</option>
                            <option value="Within budget">Within budget</option>
                            <option value="Stretch possible">Stretch possible</option>
                            <option value="Out of budget">Out of budget</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label text-uppercase text-muted fw-bold small mb-1" style="font-size: 0.7rem;">
                            Decision Maker
                        </label>
                        <select class="form-select form-select-sm" t-model="state.decisionMaker" t-on-change="onSiteVisitChange">
                            <option value="Not discussed">Not discussed</option>
                            <option value="Self">Self</option>
                            <option value="Family">Family</option>
                            <option value="Joint decision">Joint decision</option>
                            <option value="Investor">Investor</option>
                        </select>
                    </div>
                </div>

                <!-- Client Ke Saath Kaun Aaya Checkbox Grid -->
                <div class="mt-3 mb-2">
                    <label class="form-label text-uppercase text-muted fw-bold small mb-1 d-block" style="font-size: 0.7rem;">
                        Client Ke Saath Kaun Aaya?
                    </label>
                    <div class="row g-2">
                        <t t-foreach="['Alone', 'Wife', 'Husband', 'Father', 'Mother', 'Brother', 'Sister', 'Friend']" t-as="person" t-key="person">
                            <div class="col-6">
                                <div class="p-2 border rounded d-flex align-items-center bg-light-subtle sv-person-check" 
                                     t-on-click="() => this.toggleAccompaniedPerson(person)"
                                     style="cursor: pointer;">
                                    <input type="checkbox" class="form-check-input mt-0 me-2" 
                                           t-att-checked="state.accompaniedBy.includes(person)"
                                           style="cursor: pointer; pointer-events: none;"/>
                                    <span class="small fw-semibold" t-esc="person"/>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </xpath>
    </t>
</templates>
