<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.Chatter" t-inherit-mode="extension">
        <xpath expr="//button[contains(@class, 'o-mail-Chatter-activity')]" position="after">
            <button t-if="props.threadModel === 'crm.lead'"
                    class="o-mail-Chatter-whatsapp btn btn-secondary text-nowrap me-1"
                    t-att-class="{ 'my-2': !props.compactHeight }"
                    t-att-disabled="!state.thread.canPostMessage and props.threadId"
                    t-on-click="onClickChatterWhatsApp"
                    title="WhatsApp History &amp; Quick Follow-up">
                <i class="fa fa-whatsapp text-success me-1"/>
                <span>WhatsApp</span>
            </button>
        </xpath>
    </t>
</templates>
