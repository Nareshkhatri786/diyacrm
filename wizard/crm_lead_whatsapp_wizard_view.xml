<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_lead_whatsapp_wizard_form" model="ir.ui.view">
        <field name="name">crm.lead.whatsapp.wizard.form</field>
        <field name="model">crm.lead.whatsapp.wizard</field>
        <field name="arch" type="xml">
            <form string="Send WhatsApp Follow-up">
                <field name="lead_id" invisible="1"/>

                <div class="text-center p-3 mb-3 bg-light rounded border">
                    <div class="text-muted small text-uppercase fw-bold">Recipient</div>
                    <div class="fs-4 fw-bold text-dark my-1">
                        <field name="lead_name" readonly="1"/>
                    </div>
                    <div class="fs-5 text-success fw-bold">
                        <i class="fa fa-whatsapp me-1" title="WhatsApp" aria-label="WhatsApp"/> <field name="phone" readonly="1"/>
                    </div>
                </div>

                <!-- 4 FOLLOW-UP OPTIONS -->
                <div class="mb-3">
                    <!-- ENGLISH SECTION -->
                    <div class="d-flex align-items-center mb-2">
                        <span class="badge bg-primary text-white me-2 px-2 py-1">English</span>
                        <span class="text-muted small fw-bold text-uppercase">Standard Follow-up Message</span>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-12 col-md-6">
                            <button name="action_send_connected_en" type="object" class="btn btn-outline-success w-100 p-3 shadow-sm d-flex flex-column align-items-center justify-content-center border-2 rounded-3 text-decoration-none h-100">
                                <i class="fa fa-phone fa-2x text-success mb-2" title="Call Connected" aria-label="Call Connected"/>
                                <span class="fs-6 fw-bold text-success">Call Connected (English)</span>
                                <span class="small text-muted text-center mt-1">
                                    Send greetings, project video &amp; location link
                                </span>
                            </button>
                        </div>
                        <div class="col-12 col-md-6">
                            <button name="action_send_missed_en" type="object" class="btn btn-outline-danger w-100 p-3 shadow-sm d-flex flex-column align-items-center justify-content-center border-2 rounded-3 text-decoration-none h-100">
                                <i class="fa fa-phone-square fa-2x text-danger mb-2" title="Missed Call" aria-label="Missed Call"/>
                                <span class="fs-6 fw-bold text-danger">Missed / Busy (English)</span>
                                <span class="small text-muted text-center mt-1">
                                    Send apology, executive contact &amp; call back request
                                </span>
                            </button>
                        </div>
                    </div>

                    <!-- GUJARATI SECTION -->
                    <div class="d-flex align-items-center mb-2">
                        <span class="badge bg-success text-white me-2 px-2 py-1">ગુજરાતી</span>
                        <span class="text-muted small fw-bold text-uppercase">Gujarati Follow-up Message</span>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-12 col-md-6">
                            <button name="action_send_connected_gu" type="object" class="btn btn-outline-success w-100 p-3 shadow-sm d-flex flex-column align-items-center justify-content-center border-2 rounded-3 text-decoration-none h-100">
                                <i class="fa fa-phone fa-2x text-success mb-2" title="Call Connected" aria-label="Call Connected"/>
                                <span class="fs-6 fw-bold text-success">Call Connected (ગુજરાતી)</span>
                                <span class="small text-muted text-center mt-1">
                                    પ્રોજેક્ટ વિડીયો, બ્રોશર &amp; લોકેશન લિંક
                                </span>
                            </button>
                        </div>
                        <div class="col-12 col-md-6">
                            <button name="action_send_missed_gu" type="object" class="btn btn-outline-danger w-100 p-3 shadow-sm d-flex flex-column align-items-center justify-content-center border-2 rounded-3 text-decoration-none h-100">
                                <i class="fa fa-phone-square fa-2x text-danger mb-2" title="Missed Call" aria-label="Missed Call"/>
                                <span class="fs-6 fw-bold text-danger">Missed / Busy (ગુજરાતી)</span>
                                <span class="small text-muted text-center mt-1">
                                    કોલ બેક વિનંતી &amp; એક્ઝિક્યુટિવ સંપર્ક
                                </span>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="mt-4" invisible="not whatsapp_message_ids">
                    <h6 class="text-uppercase text-muted fw-bold mb-2 small">
                        <i class="fa fa-comments me-1" title="History" aria-label="History"/> WhatsApp Conversation History
                    </h6>
                    <field name="whatsapp_message_ids" readonly="1">
                        <list create="false" delete="false" edit="false" default_order="date desc">
                            <field name="date" string="Date/Time"/>
                            <field name="direction" widget="badge" decoration-success="direction == 'inbound'" decoration-info="direction == 'outbound'"/>
                            <field name="author_name" string="Sender"/>
                            <field name="body" string="Message"/>
                        </list>
                    </field>
                </div>

                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_crm_lead_whatsapp_wizard" model="ir.actions.act_window">
        <field name="name">WhatsApp Follow-up</field>
        <field name="res_model">crm.lead.whatsapp.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
