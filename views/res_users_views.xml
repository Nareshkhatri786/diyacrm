<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_diyacrm_developer" model="ir.ui.view">
        <field name="name">res.users.form.diyacrm.developer</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']//group[1]" position="after">
                <group string="🏢 Diya CRM Property Access">
                    <field name="is_property_developer" widget="boolean_toggle"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
