<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Client Action for Executive Dashboard -->
    <record id="action_crm_executive_dashboard" model="ir.actions.client">
        <field name="name">Executive Dashboard</field>
        <field name="tag">crm_executive_dashboard</field>
        <field name="target">current</field>
    </record>

    <!-- 2. Menu Item in CRM Root (Top Menu / Reporting) -->
    <menuitem id="menu_crm_executive_dashboard"
              name="📊 Executive Dashboard"
              parent="crm.crm_menu_root"
              action="action_crm_executive_dashboard"
              sequence="1"/>

    <!-- Also under Reporting for easy navigation -->
    <menuitem id="menu_crm_reporting_executive_dashboard"
              name="📊 Executive Dashboard"
              parent="crm.crm_menu_report"
              action="action_crm_executive_dashboard"
              sequence="1"/>
</odoo>
